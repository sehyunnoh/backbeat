---
// The common drum-kit key on a five-line staff, with numbered badges keyed to a legend.
import { NOTE_Y, STAFF_LINES } from '../lib/notation';
import type { LaneId } from '../lib/pattern';

const items: { n: number; lane: LaneId; name: string; where: string; cymbal: boolean }[] = [
  { n: 1, lane: 'crash', name: 'Crash', where: '× on a ledger line above the staff', cymbal: true },
  { n: 2, lane: 'hh', name: 'Hi-hat', where: '× in the space above the top line', cymbal: true },
  { n: 3, lane: 'ride', name: 'Ride', where: '× on the top line', cymbal: true },
  { n: 4, lane: 'tom1', name: 'Tom 1 (high tom)', where: '● in the top space', cymbal: false },
  { n: 5, lane: 'tom2', name: 'Tom 2 (middle tom)', where: '● on the fourth line', cymbal: false },
  { n: 6, lane: 'sn', name: 'Snare', where: '● in the third space', cymbal: false },
  { n: 7, lane: 'tom3', name: 'Tom 3 (floor tom)', where: '● in the second space', cymbal: false },
  { n: 8, lane: 'bd', name: 'Kick', where: '● in the bottom space', cymbal: false },
];
const X0 = 64;
const GAP = 66;
const W = X0 + items.length * GAP;
---

<figure class="key figure">
  <svg viewBox={`0 -14 ${W} 112`} role="img" aria-label="A drum staff showing where crash, hi-hat, ride, three toms, snare and kick are written.">
    {STAFF_LINES.map((y) => <line x1="6" y1={y} x2={W - 6} y2={y} class="staff" />)}
    <line x1="6" y1="40" x2="6" y2="80" class="bar" />
    <line x1={W - 6} y1="40" x2={W - 6} y2="80" class="bar" />
    <rect x="16" y="46" width="4.5" height="28" rx="1" class="ink" />
    <rect x="25" y="46" width="4.5" height="28" rx="1" class="ink" />
    {
      items.map((it, i) => {
        const x = X0 + i * GAP;
        const y = NOTE_Y[it.lane];
        return (
          <g>
            {y < 38 && <line x1={x - 10} y1="30" x2={x + 10} y2="30" class="stroke" stroke-width="1.6" />}
            {it.cymbal ? (
              <path d={`M${x - 4.6} ${y - 4.6}L${x + 4.6} ${y + 4.6}M${x + 4.6} ${y - 4.6}L${x - 4.6} ${y + 4.6}`} class="xhead" />
            ) : (
              <ellipse cx={x} cy={y} rx="6" ry="4.4" transform={`rotate(-20 ${x} ${y})`} class="ink" />
            )}
            <circle cx={x} cy="-3" r="10" class="badge" />
            <text x={x} y="1.5" text-anchor="middle" class="num">{it.n}</text>
          </g>
        );
      })
    }
  </svg>
  <ol class="legend">
    {
      items.map((it) => (
        <li>
          <span class="b">{it.n}</span>
          <span><strong>{it.name}</strong> <span class="where">{it.where}</span></span>
        </li>
      ))
    }
  </ol>
  <figcaption>The most common layout. Some books place the cymbals slightly differently, so check the key at the top of any chart you read.</figcaption>
</figure>

<style>
  .key { margin: 1.6rem 0; padding: 0.9rem; background: var(--surface); border: 1.5px solid var(--line); border-radius: var(--radius); }
  svg { width: 100%; height: auto; display: block; }
  .staff { stroke: var(--ink); stroke-width: 1.3; }
  .bar { stroke: var(--ink); stroke-width: 2; }
  .ink { fill: var(--ink); }
  .stroke { stroke: var(--ink); }
  .xhead { stroke: var(--ink); stroke-width: 2.3; stroke-linecap: round; fill: none; }
  .badge { fill: var(--accent); stroke: var(--ink); stroke-width: 1.8; }
  .num { font: 800 12px var(--font-display); fill: var(--ink); }
  .legend { list-style: none; padding: 0; margin: 0.9rem 0 0; display: grid; gap: 0.5rem 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .legend li { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0; font-size: 0.95rem; }
  .b { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); border: 2px solid var(--ink); display: grid; place-items: center; font: 800 0.75rem var(--font-display); }
  .where { display: block; color: var(--ink-2); font-size: 0.9rem; }
  figcaption { margin-top: 0.8rem; font-size: 0.88rem; color: var(--ink-2); }
</style>
